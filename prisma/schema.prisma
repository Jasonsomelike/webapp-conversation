generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                   String    @id @default(uuid()) @db.Uuid
  username             String    @unique @db.VarChar(32)
  displayName          String    @map("display_name") @db.VarChar(64)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  securityQuestion     String    @map("security_question") @db.VarChar(255)
  securityAnswerHash   String    @map("security_answer_hash") @db.VarChar(255)
  difyUserId           String    @unique @map("dify_user_id") @db.VarChar(128)
  theme                String    @default("forest") @db.VarChar(32)
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz

  conversations ChatConversation[]
  messages      ChatMessage[]
  references    MessageReference[]
  graphNodes    GraphNode[]
  graphEdges    GraphEdge[]
  profile       UserProfile?
  reports       UserAnalysisReport[]
  parsedUploads ParsedUpload[]

  @@map("app_users")
}

model ChatConversation {
  id                 String   @id @default(uuid()) @db.Uuid
  appUserId          String   @map("app_user_id") @db.Uuid
  difyConversationId String   @map("dify_conversation_id") @db.VarChar(128)
  title              String?  @db.VarChar(255)
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, difyConversationId])
  @@index([appUserId, deletedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id                 String   @id @default(uuid()) @db.Uuid
  appUserId          String   @map("app_user_id") @db.Uuid
  difyConversationId String   @map("dify_conversation_id") @db.VarChar(128)
  difyMessageId      String?  @map("dify_message_id") @db.VarChar(128)
  role               String   @db.VarChar(32)
  content            String
  rawPayload         Json?    @map("raw_payload")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, difyConversationId])
  @@unique([appUserId, difyMessageId, role])
  @@map("chat_messages")
}

model MessageReference {
  id                 String   @id @default(uuid()) @db.Uuid
  appUserId          String   @map("app_user_id") @db.Uuid
  difyConversationId String?  @map("dify_conversation_id") @db.VarChar(128)
  difyMessageId      String?  @map("dify_message_id") @db.VarChar(128)
  documentName       String?  @map("document_name")
  datasetName        String?  @map("dataset_name")
  segmentId          String?  @map("segment_id") @db.VarChar(128)
  pageNumber         Int?     @map("page_number")
  originalPageNumber Int?     @map("original_page_number")
  quote              String?
  score              Decimal?
  pageImageUrl       String?  @map("page_image_url")
  sourceUrl          String?  @map("source_url")
  rawPayload         Json?    @map("raw_payload")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
  @@unique([appUserId, difyMessageId, segmentId])
  @@map("message_references")
}

model GraphNode {
  id        String   @id @default(uuid()) @db.Uuid
  appUserId String   @map("app_user_id") @db.Uuid
  nodeKey   String   @map("node_key") @db.VarChar(255)
  nodeType  String   @map("node_type") @db.VarChar(64)
  label     String   @db.VarChar(255)
  meta      Json?
  weight    Decimal  @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, nodeKey])
  @@map("graph_nodes")
}

model GraphEdge {
  id        String   @id @default(uuid()) @db.Uuid
  appUserId String   @map("app_user_id") @db.Uuid
  sourceKey String   @map("source_key") @db.VarChar(255)
  targetKey String   @map("target_key") @db.VarChar(255)
  edgeType  String   @map("edge_type") @db.VarChar(64)
  weight    Decimal  @default(1)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, sourceKey, targetKey, edgeType])
  @@map("graph_edges")
}

model UserProfile {
  appUserId      String   @id @map("app_user_id") @db.Uuid
  learningStage  String?  @map("learning_stage") @db.VarChar(64)
  preferredStyle String?  @map("preferred_style") @db.VarChar(64)
  target         String?  @db.VarChar(128)
  weakTopics     Json?    @map("weak_topics")
  strongTopics   Json?    @map("strong_topics")
  interests      Json?
  profileSummary String?  @map("profile_summary")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserAnalysisReport {
  id              String   @id @default(uuid()) @db.Uuid
  appUserId       String   @map("app_user_id") @db.Uuid
  reportType      String   @map("report_type") @db.VarChar(64)
  summary         String?
  metrics         Json?
  recommendations Json?
  rawPayload      Json?    @map("raw_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
  @@map("user_analysis_reports")
}
model ParsedUpload {
  id            String   @id @default(uuid()) @db.Uuid
  appUserId     String   @map("app_user_id") @db.Uuid
  filename      String   @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(128)
  extension     String   @db.VarChar(24)
  size          Int
  extractedText String   @map("extracted_text")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
  @@map("parsed_uploads")
}

model KnowledgeDocumentCatalog {
  id           String    @id @default("default") @db.VarChar(32)
  documents    Json
  total        Int
  refreshedAt  DateTime  @map("refreshed_at") @db.Timestamptz
  refreshError String?   @map("refresh_error")
  failedAt     DateTime? @map("failed_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("knowledge_document_catalog")
}
